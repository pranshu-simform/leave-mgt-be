generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventAction {
  SUBMITTED
  AUTO_APPROVED
  APPROVED
  REJECTED
  EDITED
  CANCELLED
}

enum LedgerReason {
  ALLOCATION
  DEDUCT
  REFUND
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  managerId String? @map("manager_id") @db.Uuid

  manager         User?                @relation("ManagerReports", fields: [managerId], references: [id])
  reports         User[]               @relation("ManagerReports")
  decidedRequests LeaveRequest[]       @relation("RequestDecider")
  ledgerEntries   LeaveBalanceLedger[]
  refreshTokens   RefreshToken[]
  balances        LeaveBalance[]
  leaveRequests   LeaveRequest[]       @relation("RequestOwner")
  requestEvents   LeaveRequestEvent[]

  @@index([managerId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model LeaveType {
  id                   String   @id @default(uuid(7)) @db.Uuid
  code                 String   @unique
  name                 String
  drawsFromBalance     Boolean  @map("draws_from_balance")
  defaultAllowanceDays Int      @map("default_allowance_days")
  allowRetroactive     Boolean  @default(false) @map("allow_retroactive")
  minNoticeDays        Int      @default(0) @map("min_notice_days")
  maxConsecutiveDays   Int?     @map("max_consecutive_days")
  requiresNote         Boolean  @default(false) @map("requires_note")
  requiresApproval     Boolean  @default(true) @map("requires_approval")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model PublicHoliday {
  id   String   @id @default(uuid(7)) @db.Uuid
  date DateTime @unique @db.Date
  name String

  @@map("public_holidays")
}

model LeaveBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  year        Int
  allowance   Int
  used        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User                 @relation(fields: [userId], references: [id])
  leaveType LeaveType            @relation(fields: [leaveTypeId], references: [id])
  ledger    LeaveBalanceLedger[]

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveBalanceLedger {
  id        String       @id @default(uuid(7)) @db.Uuid
  balanceId String       @map("balance_id") @db.Uuid
  delta     Int
  reason    LedgerReason
  requestId String?      @map("request_id") @db.Uuid
  actorId   String?      @map("actor_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  balance LeaveBalance  @relation(fields: [balanceId], references: [id])
  request LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("leave_balance_ledger")
}

model LeaveRequest {
  id          String      @id @default(uuid(7)) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  leaveTypeId String      @map("leave_type_id") @db.Uuid
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  days        Int
  note        String?
  status      LeaveStatus @default(PENDING)
  version     Int         @default(1)
  decidedBy   String?     @map("decided_by") @db.Uuid
  decidedAt   DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User                 @relation("RequestOwner", fields: [userId], references: [id])
  decider   User?                @relation("RequestDecider", fields: [decidedBy], references: [id])
  leaveType LeaveType            @relation(fields: [leaveTypeId], references: [id])
  events    LeaveRequestEvent[]
  ledger    LeaveBalanceLedger[]

  @@index([userId, startDate])
  @@index([status, createdAt, id])
  @@map("leave_requests")
}

model LeaveRequestEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  requestId  String       @map("request_id") @db.Uuid
  actorId    String       @map("actor_id") @db.Uuid
  action     EventAction
  fromStatus LeaveStatus? @map("from_status")
  toStatus   LeaveStatus  @map("to_status")
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  request LeaveRequest @relation(fields: [requestId], references: [id])
  actor   User         @relation(fields: [actorId], references: [id])

  @@map("leave_request_events")
}
