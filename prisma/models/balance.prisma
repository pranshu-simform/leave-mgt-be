enum LedgerReason {
  ALLOCATION
  DEDUCT
  REFUND
  ADJUSTMENT
}

model LeaveBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  year        Int
  allowance   Int
  used        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User                 @relation(fields: [userId], references: [id])
  leaveType LeaveType            @relation(fields: [leaveTypeId], references: [id])
  ledger    LeaveBalanceLedger[]

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveBalanceLedger {
  id        String       @id @default(uuid(7)) @db.Uuid
  balanceId String       @map("balance_id") @db.Uuid
  delta     Int
  reason    LedgerReason
  requestId String?      @map("request_id") @db.Uuid
  actorId   String?      @map("actor_id") @db.Uuid
  note      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  balance LeaveBalance  @relation(fields: [balanceId], references: [id])
  request LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([balanceId])
  @@map("leave_balance_ledger")
}
