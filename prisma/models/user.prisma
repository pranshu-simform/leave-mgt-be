enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  managerId String? @map("manager_id") @db.Uuid

  manager         User?                @relation("ManagerReports", fields: [managerId], references: [id])
  reports         User[]               @relation("ManagerReports")
  decidedRequests LeaveRequest[]       @relation("RequestDecider")
  ledgerEntries   LeaveBalanceLedger[]
  refreshTokens   RefreshToken[]
  balances        LeaveBalance[]
  leaveRequests   LeaveRequest[]       @relation("RequestOwner")
  requestEvents   LeaveRequestEvent[]

  @@index([managerId])
  @@map("users")
}
