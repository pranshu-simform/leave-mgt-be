{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "rules": {
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["src/config/env.ts", "prisma/seed.ts", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
