DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leave_management
DATABASE_POOL_MAX=10

PORT=4000
NODE_ENV=development


FRONTEND_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info


JWT_SECRET=replace-with-the-output-of-openssl-rand-hex-32


COOKIE_SECURE=false


# Email is optional: without EMAIL_PROVIDER it is switched off and the API logs what it would send.
# smtp is the only provider today.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Leave & Absence <leave-bot@leavepoc.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
# A real SMTP server also needs a login:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
